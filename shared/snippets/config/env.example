# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# Base URL for the backend API. Leave empty to proxy through dev server (/api).
# %API_BASE_VAR% is replaced per stack: VITE_API_BASE_URL (Vue/React), EXPO_PUBLIC_API_BASE_URL (RN).
%API_BASE_VAR%=http://localhost:3000
